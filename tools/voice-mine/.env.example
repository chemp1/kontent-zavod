# Настройки прогона tools/voice-mine. Скопируй в `.env` рядом (он в git не попадает).
# Формат - shell-совместимый: значения с пробелами в кавычках. Файл читают
# и `run.sh` (через `source`), и `check.py` (сам, при запуске руками);
# уже заданные переменные окружения имеют приоритет над файлом.

# Команда, которая кладёт расшифровки в .data/tools/voice-mine/transcripts.jsonl
# (формат - в README). run.sh запускает её перед разбором; если команда
# вернула не 0, разбор пропускается. Пусто - файл должен лежать заранее.
# DUMP_COMMAND="python3 /path/to/dump_transcripts.py --days 2"

# За сколько суток брать звонки в кроне (при запуске руками - флаг --days).
# VOICE_MINE_DAYS=2

# Куда слать уведомление о новых кандидатах. Варианты:
#   stdout   - напечатать в лог (по умолчанию, ничего настраивать не нужно)
#   webhook  - POST JSON {"text": "..."} на NOTIFY_URL (Slack, Mattermost, n8n...)
#   telegram - Bot API: сообщение от своего бота в свой чат
#   command  - любая своя команда, текст уведомления приходит в stdin
NOTIFY=stdout

# NOTIFY=webhook
# NOTIFY_URL=https://hooks.example.com/services/xxx

# NOTIFY=telegram
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# NOTIFY=command
# NOTIFY_COMMAND="python3 /path/to/my_notify.py"

# Ссылка на страницу кандидатов в студии - ставится в конец уведомления.
# STUDIO_URL=http://127.0.0.1:5180/plan/candidates

# Корень репозитория. Нужен только если инструмент лежит вне клона с `.git`.
# WORKSHOP_ROOT=/path/to/repo

# Карточка автора, если она не в voice/author.json.
# AUTHOR_FILE=/path/to/author.json
